# ---------------------------------------------------------------
# La Peau by Chloe — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# ---------------------------------------------------------------

# Public site URL (used for metadata / Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/apikeys) — use test keys locally
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Manual payment handles shown at checkout
NEXT_PUBLIC_CASHAPP_CASHTAG=$LaPeauByChloe
NEXT_PUBLIC_ZELLE_RECIPIENT=payments@lapeaubychloe.com
NEXT_PUBLIC_ZELLE_NAME=La Peau by Chloe

# Optional: POST every new order as JSON to this URL
# (Zapier / Make / Slack incoming webhook / Google Apps Script → Sheet)
ORDER_WEBHOOK_URL=

# Product image file extension. Placeholders ship as "svg".
# After you drop in your real photos (see docs/IMAGE_GUIDE.md) set this to "jpg".
NEXT_PUBLIC_IMAGE_EXT=jpg
